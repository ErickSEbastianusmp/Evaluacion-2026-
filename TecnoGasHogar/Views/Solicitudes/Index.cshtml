@model IEnumerable<TecnoGasHogar.Models.SolicitudServicio>

@{
    ViewData["Title"] = "Listado de Solicitudes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Solicitudes de Servicio</h2>
        <a asp-action="Create" class="btn btn-primary">Nueva Solicitud</a>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Teléfono</th>
                <th>Distrito</th>
                <th>Tipo de Servicio</th>
                <th>Descripción</th>
                <th>Fecha de Registro</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Cliente</td>
                    <td>@item.Telefono</td>
                    <td>@item.Distrito</td>
                    <td>
                        <span class="badge bg-info text-dark">@item.TipoServicio</span>
                    </td>
                    <td>@item.Descripcion</td>
                    <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>